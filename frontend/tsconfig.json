{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"]
	},
	"include": [
		"src",
		"vite.config.ts",
		"prettier.config.js",
		"eslint.config.js",
		"playwright.config.ts"
	],
	"exclude": [
		"src/service-worker",
		"src/service-worker.js",
		"src/service-worker.ts",
		"src/service-worker.d.ts"
	]
}
